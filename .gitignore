# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/ios/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Code generation output — regenerate with `dart run build_runner build`
*.g.dart
*.freezed.dart

# gen_l10n output — regenerate with `flutter gen-l10n`
lib/l10n/app_localizations*.dart
lib/l10n/untranslated.json

# Firebase client config files are intentionally committed. They contain
# project identifiers/public API keys, not server credentials; CI and store
# builds need the same files that `flutterfire configure` generated.

# Generated from openapi/openapi.json. Regenerate with tool/sync_openapi.sh
# then `dart run build_runner build`. openapi/openapi.json IS committed.
lib/core/api/generated/

# Real API keys and local configs. Copy an env/*.json and fill in the blanks.
env/*.local.json
env/local.json
*.local.json
.env
.env.*
*.env

# Android & Gradle artifacts and local configs
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
**/captures/
**/local.properties

# Android keystore and release signing keys
**/key.properties
**/*.keystore
**/*.jks

# iOS / macOS local configs, credentials and Xcode user state
**/GoogleMaps.xcconfig
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/

# Apple certificates and provisioning profiles
*.p8
*.p12
*.cer
*.mobileprovision

# AI & local editor caches
.claude/

