# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Code generation output — regenerate with `dart run build_runner build`
*.g.dart
*.freezed.dart

# gen_l10n output — regenerate with `flutter gen-l10n`
lib/l10n/app_localizations*.dart
lib/l10n/untranslated.json

# Firebase config. Never commit these; each developer pulls their own.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Generated from openapi/openapi.json. Regenerate with tool/sync_openapi.sh
# then `dart run build_runner build`. openapi/openapi.json IS committed.
lib/core/api/generated/
